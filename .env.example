# ClipCat Frontend Environment Configuration
# Notice: All VITE_* variables are bundled into browser client code.
# NEVER put private API keys, signing secrets, passwords, or database credentials here.

# FastAPI Backend Base URL (local-first default for development; use HTTPS in public deployments)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Set to "true" ONLY for isolated frontend development with mock adapters.
# Ignored in production builds unless explicitly built with VITE_USE_MOCK_API=true.
VITE_USE_MOCK_API=false

# Application Version
VITE_APP_VERSION=0.1.0

# Public Production Canonical Origin (set to real HTTPS deployment URL, e.g. https://clipcat.example)
# Leave empty until your production domain is provisioned; canonical & sitemap URLs require a real domain.
VITE_PUBLIC_SITE_URL=

# Privacy-Conscious Product Analytics & Error Diagnostics (frontend-safe public configuration)
# Tracking remains inactive until BOTH explicit config AND user consent are granted.
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_PROVIDER=none
VITE_ANALYTICS_ENDPOINT=
VITE_ERROR_REPORTING_ENABLED=false

# Single Dimension Projects (SDP) public website & support links
VITE_SDP_WEBSITE_URL=https://single-dimension-projects.vercel.app
VITE_SDP_SUPPORT_URL=https://single-dimension-projects.vercel.app/contact
VITE_SDP_SUPPORT_EMAIL=
