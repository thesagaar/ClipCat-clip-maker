# ClipCat Frontend Environment Configuration

# FastAPI Backend Base URL (local-first default)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Set to "true" ONLY for isolated frontend development with mock adapters.
# Must be "false" when connected to the Python FastAPI backend.
VITE_USE_MOCK_API=false

# Application Version
VITE_APP_VERSION=0.1.0

# Single Dimension Projects (SDP) website & support links
VITE_SDP_WEBSITE_URL=https://single-dimension-projects.vercel.app
VITE_SDP_SUPPORT_URL=https://single-dimension-projects.vercel.app/contact
VITE_SDP_SUPPORT_EMAIL=
